@{
    ViewData["Title"] = "Agent Inbox";
    var tabs = (string[])ViewBag.Tabs;
    var current = (string)ViewBag.Tab;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Inbox</h3>
    <span class="text-muted">Signed in as <strong>@ViewBag.AdminName</strong></span>
</div>

<ul class="nav nav-tabs mb-3" id="inboxTabs">
    @foreach (var t in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(t == current ? "active" : "")"
               asp-action="Inbox" asp-route-tab="@t" data-tab="@t">@t</a>
        </li>
    }
</ul>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Category</th>
                <th>Sub-option</th>
                <th>Status</th>
                <th>Assigned to</th>
                <th>Last message</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="inboxRows">
            <tr><td colspan="7" class="text-center text-muted">Loading…</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const CURRENT_TAB = "@current";
    </script>
    <script src="~/js/admin-inbox.js" asp-append-version="true"></script>
}
